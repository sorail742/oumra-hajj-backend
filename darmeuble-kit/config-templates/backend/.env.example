# DarMeuble backend — variables d'environnement
#
# Noms uniquement, jamais de valeur réelle dans ce fichier ni dans aucun
# commit — voir docs/backend/coding-rules-backend.md.

NODE_ENV=development
PORT=3000
API_PREFIX=api

DATABASE_URL=

# Access court + refresh opaque avec rotation — voir docs/backend/adr/0004-*.md.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP locataire (téléphone + code SMS) — voir docs/backend/socle-backend.md §5.
OTP_TTL_SECONDS=300
OTP_CODE_LENGTH=6

# Djomy — noms de variables à confirmer contre la documentation technique
# réelle (voir docs/backend/paiements-djomy.md §"Hypothèse à vérifier en
# premier"). Placeholders de départ, pas un contrat vérifié.
DJOMY_API_KEY=
DJOMY_MERCHANT_ID=
DJOMY_WEBHOOK_SECRET=

# Fournisseur SMS — non choisi (docs/backend/socle-backend.md §0bis).
SMS_PROVIDER_API_KEY=

# CORS
FRONTEND_URL=http://localhost:3010

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
