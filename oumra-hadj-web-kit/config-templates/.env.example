# oumra-hadj-web — variables d'environnement
#
# Noms uniquement, jamais de valeur réelle dans ce fichier ni dans aucun
# commit — voir docs/coding-rules-frontend.md et
# Oumra-hadj-project/docs/secrets-management.md pour la règle en vigueur
# sur l'écosystème.

# URL du backend NestJS — variable SERVEUR uniquement, jamais préfixée
# NEXT_PUBLIC_ (voir ADR-0002 et docs/architecture.md § Le proxy).
BACKEND_URL=

# Requis en production pour que `secure` soit correctement évalué par
# `lib/auth/cookie.ts` (NODE_ENV est déjà positionné par Next, listé ici
# pour mémoire — ne pas le redéfinir manuellement).
# NODE_ENV=production
