# Copier ce fichier vers .env et renseigner des valeurs locales.
# Ne jamais committer .env avec de vraies valeurs (voir CLAUDE.md).

NODE_ENV=development
PORT=3333
API_PREFIX=api

# PostgreSQL/Prisma — voir ADR 0013.
DATABASE_URL=postgresql://oumra_hadj:oumra_hadj_dev@localhost:5432/oumra_hadj_dev

# JWT — voir ADR 0003. Générer des secrets forts et distincts par environnement.
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=30d

# OTP — voir ADR 0003 / ADR 0006 (fournisseur SMS non choisi à ce stade)
OTP_TTL_SECONDS=300
OTP_CODE_LENGTH=6

# OTP par email via EmailJS — voir ADR 0025. Laisser vide en local : le code
# est alors journalisé (développement uniquement ; en production, 503).
# Valeurs réelles uniquement dans les variables d'environnement de Render.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Réinitialisation du mot de passe agence / admin — voir ADR 0026. Gabarit
# EmailJS dédié et URL publique du frontend (lien envoyé par email). Vides en
# local : le lien est alors journalisé (développement uniquement).
EMAILJS_RESET_TEMPLATE_ID=
WEB_APP_URL=
PASSWORD_RESET_TTL_MINUTES=30

# Temps réel (ADR 0027) : secret de signature des tickets WebSocket, distinct
# des secrets JWT. Obligatoire en production (sinon temps réel désactivé).
REALTIME_TICKET_SECRET=

# Limitation de débit (protection brute-force)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
