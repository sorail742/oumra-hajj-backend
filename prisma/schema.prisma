// Schéma Prisma — voir docs/adr/0013-migration-postgresql-prisma.md.
// Migration exécutée module par module (docs/roadmap.md) ; ce fichier
// définit l'ensemble du graphe relationnel dès le départ (les clés
// étrangères l'exigent), mais chaque service n'est branché sur Prisma
// qu'au moment de la migration de son module.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 : l'URL de connexion ne se déclare plus ici mais dans
// prisma.config.ts (CLI/migrations) et via un driver adapter côté
// PrismaService (runtime) — voir https://pris.ly/d/driver-adapters.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  pilgrim
  agency
  guide
  admin
}

enum AgencyValidationStatus {
  pending
  approved
  rejected
}

enum PilgrimageType {
  oumra
  hadj
}

enum PackageStatus {
  open
  full
  closed
}

enum BookingStatus {
  pending_payment
  confirmed
  cancelled
  completed
}

enum DossierStepKey {
  payment
  visa
  flight
  vaccination
  documents
}

enum DossierStepStatus {
  pending
  in_progress
  done
}

enum PaymentMethod {
  mobile_money_orange
  mobile_money_mtn
  card
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum PilgrimDocumentType {
  passport
  visa
  flight_ticket
  vaccination_certificate
}

enum PilgrimDocumentStatus {
  pending
  validated
  rejected
}

enum RiteSheetPilgrimageType {
  oumra
  hadj
  both
}

enum NotificationType {
  booking_status
  payment
  document
  rite_reminder
  sos
  group_message
  moderation
  other
}

enum MessagingChannel {
  agency
  guide
}

// ---------------------------------------------------------------------------
// Auth (ADR 0003)
// ---------------------------------------------------------------------------

model User {
  id                String   @id @default(uuid())
  fullName          String
  phone             String?  @unique
  email             String?  @unique
  passwordHash      String?
  role              Role
  preferredLanguage String   @default("fr")
  bloodType         String?
  passportNumber    String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Contact d'urgence — colonnes plutôt qu'un sous-document (relationnel).
  emergencyContactFullName     String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  // Agence de rattachement pour un utilisateur guide.
  agencyId String?
  agency   Agency? @relation("AgencyGuides", fields: [agencyId], references: [id])

  ownedAgency         Agency?               @relation("AgencyOwner")
  refreshTokens       RefreshToken[]
  bookingsAsPilgrim   Booking[]             @relation("BookingPilgrim")
  documents           PilgrimDocument[]
  riteProgress        RiteProgress[]
  microCourseProgress MicroCourseProgress[]
  notifications       Notification[]
  reviews             Review[]
  sentMessages        Message[]
  validatedAgencies   Agency[]              @relation("AgencyValidatedBy")
  validatedRiteSheets RiteSheet[]           @relation("RiteSheetValidatedBy")
  guidedGroups        Group[]               @relation("GroupGuide")
  groupMemberships    GroupMember[]
  groupLocations      GroupMemberLocation[]
  communityMessages   CommunityMessage[]
  ownedAgency            Agency?               @relation("AgencyOwner")
  refreshTokens          RefreshToken[]
  bookingsAsPilgrim      Booking[]             @relation("BookingPilgrim")
  documents              PilgrimDocument[]
  riteProgress           RiteProgress[]
  microCourseProgress    MicroCourseProgress[]
  notifications          Notification[]
  reviews                Review[]
  sentMessages           Message[]
  validatedAgencies      Agency[]              @relation("AgencyValidatedBy")
  validatedRiteSheets    RiteSheet[]           @relation("RiteSheetValidatedBy")
  validatedQuizQuestions QuizQuestion[]        @relation("QuizQuestionValidatedBy")
  guidedGroups           Group[]               @relation("GroupGuide")
  groupMemberships       GroupMember[]
  groupLocations         GroupMemberLocation[]
  communityMessages      CommunityMessage[]
  quizAttempts           QuizAttempt[]

  @@map("users")
}

// TTL applicatif (voir ADR 0007/0003) : purge programmée à écrire côté job
// ou cron, Postgres n'a pas d'équivalent natif à l'index TTL Mongo.
model Otp {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otps")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Agencies
// ---------------------------------------------------------------------------

model Agency {
  id                String                 @id @default(uuid())
  legalName         String
  ownerId           String                 @unique
  owner             User                   @relation("AgencyOwner", fields: [ownerId], references: [id])
  contactEmail      String
  contactPhone      String
  address           String?
  validationStatus  AgencyValidationStatus @default(pending)
  rejectionReason   String?
  validatedById     String?
  validatedBy       User?                  @relation("AgencyValidatedBy", fields: [validatedById], references: [id])
  validatedAt       DateTime?
  commissionRate    Float                  @default(0)
  bankAccountName   String?
  bankAccountNumber String?
  bankName          String?
  // Idée #70 (backlog "Cent Fonctionnalités") : jeton opaque et non expirant
  // pour l'URL d'abonnement au calendrier ICS des échéances (Google/Outlook
  // ne peuvent pas envoyer d'en-tête Authorization sur une URL
  // d'abonnement) — révocable via régénération, jamais le seul mécanisme
  // d'authentification agence.
  calendarToken     String?                @unique
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  legalDocuments AgencyLegalDocument[]
  guides         User[]                @relation("AgencyGuides")
  packages       Package[]
  groups         Group[]
  bookings       Booking[]
  reviews        Review[]

  @@index([validationStatus])
  @@map("agencies")
}

model AgencyLegalDocument {
  id         String    @id @default(uuid())
  agencyId   String
  agency     Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  label      String
  storageRef String
  uploadedAt DateTime  @default(now())
  // Idée #56 (backlog "Cent Fonctionnalités") : date d'expiration déclarée
  // par l'agence (registre de commerce, agrément, assurance...) — absente si
  // le document n'a pas de date d'expiration connue.
  expiresAt  DateTime?

  @@map("agency_legal_documents")
}

// ---------------------------------------------------------------------------
// Packages (forfaits)
// ---------------------------------------------------------------------------

model Package {
  id          String         @id @default(uuid())
  agencyId    String
  agency      Agency         @relation(fields: [agencyId], references: [id])
  type        PilgrimageType
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  price       Float
  currency    String         @default("GNF")
  capacity    Int
  seatsTaken  Int            @default(0)
  inclusions  String[]
  status      PackageStatus  @default(open)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  stages   PackageStage[]
  bookings Booking[]
  groups   Group[]

  @@index([type])
  @@index([status])
  @@map("packages")
}

// Un forfait peut inclure plusieurs etapes/hebergements (ex. Medine puis La
// Mecque) — Package.startDate/endDate restent les bornes globales du voyage,
// distinctes des dates propres a chaque etape.
model PackageStage {
  id                     String   @id @default(uuid())
  packageId              String
  package                Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  city                   String
  hotelName              String
  distanceToMosqueMeters Int?
  startDate              DateTime
  endDate                DateTime

  @@index([packageId])
  @@map("package_stages")
}

// ---------------------------------------------------------------------------
// Checklist (Ticket 3)
// ---------------------------------------------------------------------------

model ChecklistItem {
  id              String   @id @default(uuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  title           String
  category        String   // "document", "vaccine", "luggage", "spiritual"
  isCompleted     Boolean  @default(false)
  
  reminderDate    DateTime?
  reminderSent    Boolean  @default(false)
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  title       String
  category    String // "document", "vaccine", "luggage", "spiritual"
  isCompleted Boolean @default(false)

  reminderDate DateTime?
  reminderSent Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@map("checklist_items")
}

// ---------------------------------------------------------------------------
// Groups
// ---------------------------------------------------------------------------

model Group {
  id        String   @id @default(uuid())
  packageId String
  package   Package  @relation(fields: [packageId], references: [id])
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id])
  title     String
  guideId   String?
  guide     User?    @relation("GroupGuide", fields: [guideId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   GroupMember[]
  itinerary GroupItineraryStep[]
  locations GroupMemberLocation[]
  bookings  Booking[]
  members           GroupMember[]
  itinerary         GroupItineraryStep[]
  locations         GroupMemberLocation[]
  bookings          Booking[]
  communityMessages CommunityMessage[]

  @@index([agencyId])
  @@map("groups")
}

model GroupMember {
  id      String @id @default(uuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@map("group_members")
}

model GroupItineraryStep {
  id       String   @id @default(uuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label    String
  date     DateTime
  location String?

  @@map("group_itinerary_steps")
}

// Partage de position opt-in — cahier des charges §3.1.
model GroupMemberLocation {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  lat       Float
  lng       Float
  updatedAt DateTime @updatedAt

  @@unique([groupId, userId])
  @@map("group_member_locations")
}

// ---------------------------------------------------------------------------
// Bookings (réservations)
// ---------------------------------------------------------------------------

model Booking {
  id              String        @id @default(uuid())
  pilgrimId       String
  pilgrim         User          @relation("BookingPilgrim", fields: [pilgrimId], references: [id])
  packageId       String
  package         Package       @relation(fields: [packageId], references: [id])
  agencyId        String
  agency          Agency        @relation(fields: [agencyId], references: [id])
  groupId         String?
  group           Group?        @relation(fields: [groupId], references: [id])
  status          BookingStatus @default(pending_payment)
  // Idée #28 (backlog "Cent Fonctionnalités") : jeton opaque et non expirant
  // pour un lien de suivi en lecture seule, partagé par le pèlerin à sa
  // famille — pas de compte pèlerin à créer pour un proche peu digitalisé.
  // Révocable via régénération, même principe que Agency.calendarToken
  // (idée #70).
  familyViewToken String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  steps         BookingStep[]
  payments      Payment[]
  documents     PilgrimDocument[]
  review        Review?
  conversations Conversation[]
  checklists    ChecklistItem[]

  @@index([pilgrimId])
  @@index([packageId])
  @@index([agencyId])
  @@index([status])
  @@map("bookings")
}

model BookingStep {
  id        String            @id @default(uuid())
  bookingId String
  booking   Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  key       DossierStepKey
  status    DossierStepStatus @default(pending)
  updatedAt DateTime          @updatedAt

  @@unique([bookingId, key])
  @@map("booking_steps")
}

// ---------------------------------------------------------------------------
// Payments (ADR 0006)
// ---------------------------------------------------------------------------

model Payment {
  id                String        @id @default(uuid())
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id])
  amount            Float
  currency          String        @default("GNF")
  installmentNumber Int
  method            PaymentMethod
  status            PaymentStatus @default(pending)
  providerReference String        @unique
  receiptRef        String?
  confirmedAt       DateTime?
  // Idée #58 (backlog "Cent Fonctionnalités") — barème de remboursement,
  // voir PaymentsService.REFUND_POLICY. refundedAmount peut être inférieur
  // à amount (remboursement partiel selon le statut de la réservation au
  // moment de la demande).
  refundedAmount    Float?
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Documents sensibles (ADR 0008)
// ---------------------------------------------------------------------------

model PilgrimDocument {
  id              String                @id @default(uuid())
  bookingId       String
  booking         Booking               @relation(fields: [bookingId], references: [id])
  pilgrimId       String
  pilgrim         User                  @relation(fields: [pilgrimId], references: [id])
  type            PilgrimDocumentType
  storageRef      String
  status          PilgrimDocumentStatus @default(pending)
  rejectionReason String?
  // Idée #59 (backlog "Cent Fonctionnalités") : date d'expiration déclarée
  // par le pèlerin à l'upload (passeport, visa...) — absente si le type de
  // document n'en a pas (billet d'avion) ou si elle n'est pas connue.
  expiresAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([bookingId])
  @@index([pilgrimId])
  @@map("pilgrim_documents")
}

// ---------------------------------------------------------------------------
// Rites — contenu religieux (modération obligatoire, voir CLAUDE.md)
// ---------------------------------------------------------------------------

model RiteSheet {
  id             String                  @id @default(uuid())
  key            String
  title          String
  pilgrimageType RiteSheetPilgrimageType
  order          Int                     @default(0)
  content        String
  audioRef       String?
  language       String                  @default("fr")
  version        Int                     @default(1)
  isValidated    Boolean                 @default(false)
  validatedById  String?
  validatedBy    User?                   @relation("RiteSheetValidatedBy", fields: [validatedById], references: [id])
  validatedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  quizQuestions QuizQuestion[]

  @@index([key])
  @@map("rite_sheets")
}

model RiteProgress {
  id              String   @id @default(uuid())
  pilgrimId       String
  pilgrim         User     @relation(fields: [pilgrimId], references: [id])
  riteKey         String
  completed       Boolean  @default(false)
  tawafCount      Int      @default(0)
  saiCount        Int      @default(0)
  clientUpdatedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([pilgrimId, riteKey])
  @@map("rite_progress")
}

// ---------------------------------------------------------------------------
// Notifications (ADR 0009)
// ---------------------------------------------------------------------------

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  recipient   User             @relation(fields: [recipientId], references: [id])
  type        NotificationType
  title       String
  content     String
  isCritical  Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([recipientId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(uuid())
  pilgrimId String
  pilgrim   User     @relation(fields: [pilgrimId], references: [id])
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id])
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([agencyId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Messagerie (ADR 0014) — deux fils strictement séparés et privés par
// réservation (agence, guide), jamais fusionnés. Pas de modération admin sur
// ce canal (contrairement au contenu religieux). Rétention : purge
// applicative à écrire côté job/cron une fois `Booking.status` à `completed`
// depuis un délai configurable — pas d'équivalent Postgres natif à un TTL,
// même limitation que pour `Otp` ci-dessus.
// ---------------------------------------------------------------------------

model Conversation {
  id        String           @id @default(uuid())
  bookingId String
  booking   Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  channel   MessagingChannel
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  messages Message[]

  @@unique([bookingId, channel])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  // Horodatage client, pour l'ordre d'affichage cote mobile (meme pattern que
  // RiteProgress.clientUpdatedAt) — le serveur reste seul juge de l'ordre de
  // persistance via `createdAt`.
  clientSentAt   DateTime
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Micro-cours "Préparer sa Oumra/Hadj" (Ticket 4 - ADR 0007)
// ---------------------------------------------------------------------------

model MicroCourse {
  id              String                @id @default(uuid())
  id              String   @id @default(uuid())
  title           String
  description     String?
  videoUrl        String
  durationSeconds Int                   @default(0)
  order           Int                   @default(0)
  category        String                @default("preparation") // "preparation", "rites", "health", "logistics"
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  durationSeconds Int      @default(0)
  order           Int      @default(0)
  category        String   @default("preparation") // "preparation", "rites", "health", "logistics"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  progress        MicroCourseProgress[]
  progress MicroCourseProgress[]

  @@map("micro_courses")
}

model MicroCourseProgress {
  id              String      @id @default(uuid())
  pilgrimId       String
  pilgrim         User        @relation(fields: [pilgrimId], references: [id], onDelete: Cascade)
  courseId        String
  course          MicroCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  isCompleted     Boolean     @default(false)
  clientUpdatedAt DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([pilgrimId, courseId])
  @@index([pilgrimId])
  @@index([courseId])
  @@map("micro_course_progress")
}

// ---------------------------------------------------------------------------
// Communauté pré-départ (Ticket 5 - ADR 0023)
// ---------------------------------------------------------------------------

model CommunityMessage {
  id           String   @id @default(uuid())
  groupId      String
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content      String
  clientSentAt DateTime
  createdAt    DateTime @default(now())

  @@index([groupId])
  @@map("community_messages")
}

// ---------------------------------------------------------------------------
// Quiz des rites (Ticket 6)
// ---------------------------------------------------------------------------

model QuizQuestion {
  id            String    @id @default(uuid())
  riteSheetId   String
  riteSheet     RiteSheet @relation(fields: [riteSheetId], references: [id], onDelete: Cascade)
  question      String
  options       Json
  correctOption Int
  explanation   String?

  isValidated   Boolean   @default(false)
  validatedById String?
  validatedBy   User?     @relation("QuizQuestionValidatedBy", fields: [validatedById], references: [id])
  validatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts QuizAttempt[]

  @@index([riteSheetId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id             String       @id @default(uuid())
  pilgrimId      String
  pilgrim        User         @relation(fields: [pilgrimId], references: [id], onDelete: Cascade)
  questionId     String
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Int
  isCorrect      Boolean
  createdAt      DateTime     @default(now())

  @@index([pilgrimId])
  @@index([questionId])
  @@map("quiz_attempts")
}
